{
  "name": "@proteo5/bic-build",
  "version": "0.2.1",
  "description": "Build step that stores flat graphics (charts, logos, icons) as BIC when that saves bandwidth",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteo5/bic.git",
    "directory": "packages/bic-build"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./vite": "./src/vite.js",
    "./webpack": "./src/webpack.js"
  },
  "bin": {
    "bic-build": "./bin/bic-build.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node src/install-binary.js",
    "test": "node --test test/policy.test.mjs test/install-binary.test.mjs test/build.test.mjs test/vite.test.mjs test/webpack.test.mjs",
    "test:browser": "node --test test/browser.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@proteo5/bic-runtime": "file:../bic-runtime",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "html-webpack-plugin": "^5.6.8",
    "playwright-core": "^1.50.0",
    "vite": "^7.0.0",
    "webpack": "^5.112.0"
  }
}
